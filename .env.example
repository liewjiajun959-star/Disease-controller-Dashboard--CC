# GitHub Pages base path — set to your repository name with leading slash
# Example: /hantawatch-dashboard
NEXT_PUBLIC_BASE_PATH=/hantawatch-dashboard

# YouTube Data API v3 key (optional — app works without it using mock data)
# Obtain from: https://console.cloud.google.com/
# NEVER commit the real key — keep it in .env.local only
# NEXT_PUBLIC_YOUTUBE_API_KEY=

# Feature flags (optional)
# NEXT_PUBLIC_ENABLE_LIVE_NEWS=false
# NEXT_PUBLIC_ENABLE_YOUTUBE_API=false
